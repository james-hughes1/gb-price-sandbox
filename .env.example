# Copy to .env (git-ignored) and adjust. All settings are optional.

# Where raw API pulls are cached as parquet.
GBPS_DATA_DIR=data

# HTTP timeout (seconds) for API loaders.
GBPS_HTTP_TIMEOUT=30

# Base URLs (override only for testing/mocking).
GBPS_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
GBPS_NESO_BASE_URL=https://api.neso.energy/api/3/action
